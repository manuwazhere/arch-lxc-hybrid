From 1adab36850ac427cb9b09bedb783c5957268ca92 Mon Sep 17 00:00:00 2001
From: Manu <manu@localhost>
Date: Sun, 11 Oct 2026 15:59:44 +0000
Subject: [PATCH] Swap a 0, yay-bin di default, AUR_PACKAGES opzionale

---
 README.md                |  5 ++++-
 config.sh                |  7 ++++++-
 container/02-sunshine.sh | 42 ++++++++++++++++++++++++++++++----------
 container/aur-build.sh   | 13 ++++++++-----
 container/verify.sh      |  3 +++
 install.sh               |  3 ++-
 6 files changed, 55 insertions(+), 18 deletions(-)

diff --git a/README.md b/README.md
index 2ecbb7d..6df3974 100644
--- a/README.md
+++ b/README.md
@@ -50,3 +50,6 @@ files/plasma-session.service
 - **Password**: mai nel repo; chiesta a runtime o da `UTENTE_PASSWORD` (es. in `config.local.sh`).
-- **AUR**: `SUNSHINE_AUR_COMMIT` permette di fissare un commit; il PKGBUILD finisce nel log.
+- **AUR**: `yay-bin` e `sunshine-bin` si compilano con `makepkg` (`SUNSHINE_AUR_COMMIT` fissa un commit di
+  Sunshine; i PKGBUILD finiscono nel log). Poi `yay -Syu` aggiorna repo e AUR insieme. Pacchetti AUR
+  extra (es. Brave) in `AUR_PACKAGES`, meglio nel proprio `config.local.sh`. Senza helper:
+  `INSTALL_AUR_HELPER=0`, e gli aggiornamenti AUR vanno fatti a mano.
 - **Permessi GPU**: `renderD*` a 0666; `card*` a `CARD_MODE` (default 0660, da verificare).
diff --git a/config.sh b/config.sh
index 53bc5da..6dc7d7b 100644
--- a/config.sh
+++ b/config.sh
@@ -17,3 +17,3 @@ CORES=10
 MEMORY_MB=16384
-SWAP_MB=512
+SWAP_MB=0
 DISK_GB=64
@@ -60 +60,6 @@ ffmpegthumbs kdegraphics-thumbnailers kio-extras"
 DISABLE_FILE_INDEXING=1      # 1 = disattiva Baloo (indicizzazione file): evita picchi di CPU/disco
+
+# --- Helper AUR e pacchetti AUR ----------------------------------------------------
+INSTALL_AUR_HELPER=1         # 1 = installa yay-bin (con makepkg); poi `yay -Syu` aggiorna anche Sunshine
+AUR_PACKAGES=""              # pacchetti AUR in più, installati con yay (es. "brave-bin"):
+                             # vuoto nel repo, mettili nel tuo config.local.sh
diff --git a/container/02-sunshine.sh b/container/02-sunshine.sh
index 5a9eaae..31b127c 100755
--- a/container/02-sunshine.sh
+++ b/container/02-sunshine.sh
@@ -15,13 +15,35 @@ trap cleanup EXIT
 
-# --- Build dall'AUR (sudo senza password solo per la durata del build) ----------------
-if pacman -Qi sunshine-bin &>/dev/null; then
-  log "sunshine-bin già installato ($(pacman -Q sunshine-bin))"
-else
-  log "Build di sunshine-bin dall'AUR"
-  echo "$UTENTE ALL=(ALL) NOPASSWD: ALL" >"$TMP_SUDOERS"
-  chmod 440 "$TMP_SUDOERS"
-  visudo -cf "$TMP_SUDOERS" >/dev/null
-  runuser -u "$UTENTE" -- env HOME="/home/$UTENTE" bash "$STAGE/container/aur-build.sh"
-  cleanup
+as_user() { runuser -u "$UTENTE" -- env HOME="/home/$UTENTE" "$@"; }
+
+# --- Build dall'AUR (sudo senza password solo per la durata di questi passi) -----------
+log "Sudo senza password temporaneo per le build AUR"
+echo "$UTENTE ALL=(ALL) NOPASSWD: ALL" >"$TMP_SUDOERS"
+chmod 440 "$TMP_SUDOERS"
+visudo -cf "$TMP_SUDOERS" >/dev/null
+
+build_aur() { # pacchetto
+  if pacman -Qi "$1" &>/dev/null; then
+    log "$1 già installato ($(pacman -Q "$1"))"
+  else
+    log "Build di $1 dall'AUR"
+    as_user bash "$STAGE/container/aur-build.sh" "$1"
+  fi
+}
+
+# yay-bin e sunshine-bin con makepkg (Sunshine così tiene il pin e il PKGBUILD nel log);
+# da qui in poi `yay -Syu` li aggiorna entrambi.
+if ((INSTALL_AUR_HELPER)); then build_aur yay-bin; fi
+build_aur sunshine-bin
+
+if [[ -n $AUR_PACKAGES ]]; then
+  command -v yay >/dev/null || die "AUR_PACKAGES richiede INSTALL_AUR_HELPER=1."
+  read -ra aur <<<"$AUR_PACKAGES"
+  for p in "${aur[@]}"; do
+    echo "----- PKGBUILD di $p (per il log: controllalo) -----"
+    as_user yay -Gp "$p" || warn "Impossibile stampare il PKGBUILD di $p"
+  done
+  log "Installazione con yay: ${aur[*]}"
+  as_user yay -S --needed --noconfirm "${aur[@]}"
 fi
+cleanup
 
diff --git a/container/aur-build.sh b/container/aur-build.sh
index 1f0150e..37348fc 100755
--- a/container/aur-build.sh
+++ b/container/aur-build.sh
@@ -1,3 +1,4 @@
 #!/usr/bin/env bash
-# Compila e installa sunshine-bin dall'AUR. DA UTENTE NORMALE (makepkg rifiuta root).
+# Compila e installa un pacchetto dall'AUR (default: sunshine-bin).
+# Uso: aur-build.sh [pacchetto]. DA UTENTE NORMALE (makepkg rifiuta root).
 # Richiede sudo senza password: lo concede 02-sunshine.sh solo per la durata del build.
@@ -10,2 +11,3 @@ source "$STAGE/config.sh"
 [[ $EUID -ne 0 ]] || die "Non lanciare makepkg come root."
+PKG=${1:-sunshine-bin}
 
@@ -15,8 +17,9 @@ cd "$work"
 
-git clone https://aur.archlinux.org/sunshine-bin.git
-cd sunshine-bin
-if [[ -n $SUNSHINE_AUR_COMMIT ]]; then
+git clone "https://aur.archlinux.org/${PKG}.git"
+cd "$PKG"
+# Il pin del commit vale solo per Sunshine.
+if [[ $PKG == sunshine-bin && -n $SUNSHINE_AUR_COMMIT ]]; then
   git checkout --quiet "$SUNSHINE_AUR_COMMIT"
 fi
-log "AUR sunshine-bin @ $(git rev-parse --short HEAD) ($(git log -1 --format=%cd --date=short))"
+log "AUR $PKG @ $(git rev-parse --short HEAD) ($(git log -1 --format=%cd --date=short))"
 echo "----- PKGBUILD (per il log: controllalo) -----"
diff --git a/container/verify.sh b/container/verify.sh
index 4ce8bd6..5a616f3 100755
--- a/container/verify.sh
+++ b/container/verify.sh
@@ -61,2 +61,5 @@ check "Sunshine in ascolto (47990)" t_port 47990
 check "sudoers temporaneo dell'AUR rimosso" t_no_tmp_sudoers
+if ((INSTALL_AUR_HELPER)); then check "yay installato" command -v yay; fi
+read -ra aur_pkgs <<<"${AUR_PACKAGES:-}"
+for p in "${aur_pkgs[@]}"; do check "pacchetto AUR $p installato" pacman -Q "$p"; done
 
diff --git a/install.sh b/install.sh
index cc56469..32a3056 100755
--- a/install.sh
+++ b/install.sh
@@ -70,3 +70,4 @@ for v in UTENTE IP_CT TIMEZONE LOCALE KB_LAYOUT SSH_PUBKEY SSH_DISABLE_PASSWORD
   CONNETTORE RISOLUZIONE SUNSHINE_AUR_COMMIT INSTALL_DIAG EXTRA_PACKAGES \
-  PLASMA_PACKAGES INSTALL_MEDIA MEDIA_PACKAGES DISABLE_FILE_INDEXING; do
+  PLASMA_PACKAGES INSTALL_MEDIA MEDIA_PACKAGES DISABLE_FILE_INDEXING \
+  INSTALL_AUR_HELPER AUR_PACKAGES; do
   declare -p "$v"
-- 
2.43.0

